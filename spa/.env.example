# Copy to gitignored files (share URLs with the team out of band):
#   .env.local     → npm run spa:dev (LocalStack or prepare monolith)
#   .env.dev       → npm run spa:build:dev (before SPA_HOSTING=lambda deploy)
#   .env.test      → npm run spa:build:test
#   .env.prod      → npm run spa:build:prod
#
# VITE_API_BASE_URL is the HTTP API (HttpApiUrl), NOT the SPA Lambda function URL.

# --- .env.local (Vite dev) ---
# VITE_API_BASE_URL=http://127.0.0.1:3333
# VITE_API_BASE_URL=https://YOUR_ID.execute-api.localhost.localstack.cloud:4566/local

# --- .env.dev / test / prod (static build) ---
# VITE_API_BASE_URL=https://YOUR_HTTP_API.execute-api.ap-southeast-2.amazonaws.com
# VITE_COGNITO_USER_POOL_ID=ap-southeast-2_xxxxx
# VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Review page: simple (JSON textarea, default) | advanced (invoice image + field overlays)
# VITE_REVIEW_RENDER=simple
# Or at runtime: ?reviewRender=advanced on the review link

# --- .env.local (LocalStack upload page, optional) ---
# VITE_APP_STAGE=local
# VITE_PRESIGN_LOCAL_SECRET=localstack-presign-change-me
