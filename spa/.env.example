# Copy to `.env.local` (gitignored by Vite convention) or export vars in the shell before `npm run dev`.
# Pick ONE `VITE_API_BASE_URL` — the SPA uses it for `/public/invoice/*` and `/public/decision`.

# --- 1) Prepare monolith (pure Node; sibling repo `aws_cdk_invoice_processing_and_approval_prepare`, default port 3333)
VITE_API_BASE_URL=http://127.0.0.1:3333

# --- 2) LocalStack after `npm run deploy:local` (paste HttpApiUrl from CDK output)
# VITE_API_BASE_URL=http://xxxxxxxx.execute-api.localhost.localstack.cloud:4566

# --- 3) Real AWS HTTP API from CDK outputs (dev/test/prod)
# VITE_API_BASE_URL=https://xxxxxxxx.execute-api.region.amazonaws.com
