{
  "name": "aws-cdk-invoice-processing-and-approval",
  "version": "0.1.0",
  "description": "CDK: S3→SQS→Step Functions+Textract; always human approve/reject; OCR threshold only toggles manual verify vs read-only SPA. Cognito JWT uploads, EventBridge analytics. Requires Node 20+.",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "cdk": "cdk",
    "synth": "cdk synth",
    "deploy": "cdk deploy --all",
    "deploy:dev": "cdk deploy --all -c stage=dev",
    "deploy:test": "cdk deploy --all -c stage=test",
    "deploy:prod": "cdk deploy --all -c stage=prod",
    "synth:local": "cdk synth -c stage=local",
    "deploy:local": "node scripts/deploy-local-localstack.mjs",
    "destroy:local": "node scripts/destroy-local-localstack.mjs",
    "spa:dev": "npm --prefix spa run dev",
    "spa:build": "npm --prefix spa run build:dev",
    "spa:build:local": "npm --prefix spa run build:local",
    "spa:build:dev": "npm --prefix spa run build:dev",
    "spa:build:test": "npm --prefix spa run build:test",
    "spa:build:prod": "npm --prefix spa run build:prod",
    "spa:preview": "npm --prefix spa run preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo:api": "node local/mock-public-api.cjs",
    "test:e2e:local": "playwright test -c playwright.local.config.ts",
    "test:e2e:dev": "node scripts/run-playwright-dev.mjs",
    "test:e2e:dev:headed": "node scripts/run-playwright-dev.mjs -- --headed",
    "test:e2e:real:dev": "node scripts/run-playwright-dev.mjs -- e2e/invoice-upload-real-dev.spec.ts",
    "test:e2e:real:dev:headed": "node scripts/run-playwright-dev.mjs -- --headed e2e/invoice-upload-real-dev.spec.ts",
    "test:e2e:real:advanced-preview:dev": "node scripts/run-playwright-advanced-preview-dev.mjs -- e2e/invoice-review-advanced-preview-dev.spec.ts",
    "test:e2e:real:advanced-preview:dev:headed": "node scripts/run-playwright-advanced-preview-dev.mjs -- --headed e2e/invoice-review-advanced-preview-dev.spec.ts",
    "test:e2e:advanced-preview:review-only:dev": "node scripts/run-playwright-advanced-preview-dev.mjs -- -g \"advanced review UI only\"",
    "test:e2e:real:simple-preview:dev": "node scripts/run-playwright-simple-preview-dev.mjs -- e2e/invoice-review-simple-preview-dev.spec.ts",
    "test:e2e:real:simple-preview:dev:headed": "node scripts/run-playwright-simple-preview-dev.mjs -- --headed e2e/invoice-review-simple-preview-dev.spec.ts",
    "test:e2e:simple-preview:review-only:dev": "node scripts/run-playwright-simple-preview-dev.mjs -- -g \"simple review UI only\"",
    "generate:e2e-sample-invoice": "node scripts/generate-e2e-sample-invoice.mjs",
    "test:e2e:local:ui": "playwright test -c playwright.local.config.ts --ui",
    "test:e2e:dev:ui": "node scripts/run-playwright-dev.mjs -- --ui",
    "test:e2e:install": "playwright install chromium",
    "playwright:print-env:local": "node scripts/print-playwright-env.mjs",
    "playwright:print-env:dev": "node scripts/print-playwright-env-dev.mjs"
  },
  "devDependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.683.0",
    "@playwright/test": "^1.59.1",
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^20.14.0",
    "aws-cdk": "^2.1121.0",
    "aws-cdk-local": "^3.0.4",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.683.0",
    "@aws-sdk/client-eventbridge": "^3.683.0",
    "@aws-sdk/client-s3": "^3.683.0",
    "@aws-sdk/client-ses": "^3.683.0",
    "@aws-sdk/client-sfn": "^3.683.0",
    "@aws-sdk/client-sqs": "^3.683.0",
    "@aws-sdk/client-textract": "^3.683.0",
    "@aws-sdk/lib-dynamodb": "^3.683.0",
    "@aws-sdk/s3-request-presigner": "^3.683.0",
    "aws-cdk-lib": "^2.170.0",
    "constructs": "^10.4.2",
    "source-map-support": "^0.5.21"
  }
}
