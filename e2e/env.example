# Copy vars into your shell (PowerShell / bash). Playwright reads process.env only.

# --- Required ---
# HttpApiUrl output from InvoiceProcessing-local (no trailing slash).
PLAYWRIGHT_API_BASE_URL=http://127.0.0.1:4566/restapis/xxxx/...

# AWS SDK calls from tests (DynamoDB poll) — LocalStack on host when Playwright runs on host:
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1

# --- Recommended (LocalStack Community / no-login image) ---
# Matches CDK context invoice.local.presignLocalSecret (see cdk.json) or config/local.json.
# API Gateway JWT validation against Cognito is unreliable locally; presign uses header x-presign-local-secret instead.
PLAYWRIGHT_PRESIGN_LOCAL_SECRET=localstack-presign-change-me

# --- Optional: Cognito/JWT path (advanced; only if PLAYWRIGHT_USE_COGNITO=1 or presign secret unset) ---
# PLAYWRIGHT_USE_COGNITO=1
# PLAYWRIGHT_COGNITO_POOL_ID=us-east-1_xxxx
# PLAYWRIGHT_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# PLAYWRIGHT_TEST_EMAIL=e2e-invoice@local.invalid
# PLAYWRIGHT_TEST_PASSWORD=TestPass123!

PLAYWRIGHT_INVOICES_TABLE=invoice-records-local

# Optional MailHog soft-check (docker compose up -d mailhog)
# PLAYWRIGHT_MAILHOG_URL=http://localhost:8025

PLAYWRIGHT_SPA_BASE_URL=http://127.0.0.1:5173

# Skip Playwright starting Vite if you already run `npm run dev` in spa/
# PLAYWRIGHT_SKIP_WEBSERVER=1

# --- When running Playwright inside Docker (`npm run test:e2e:docker`) replace localhost with:
# AWS_ENDPOINT_URL=http://host.docker.internal:4566
# PLAYWRIGHT_API_BASE_URL=http://host.docker.internal:4566/restapis/...   (same LocalStack URL pattern your deploy prints)
