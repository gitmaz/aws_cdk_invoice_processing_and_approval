# Deployed dev stage E2E — copy into your shell. Run: npm run test:e2e:dev

# Real AWS (do not set AWS_ENDPOINT_URL)
AWS_PROFILE=my-dev
AWS_REGION=ap-southeast-2

# HttpApiUrl from InvoiceProcessing-dev. Or: npm run playwright:print-env:dev
PLAYWRIGHT_API_BASE_URL=https://xxxxxxxx.execute-api.ap-southeast-2.amazonaws.com

PLAYWRIGHT_COGNITO_POOL_ID=ap-southeast-2_xxxx
PLAYWRIGHT_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
PLAYWRIGHT_TEST_EMAIL=e2e-invoice-dev@yourdomain.invalid
PLAYWRIGHT_TEST_PASSWORD=TestPass123!

PLAYWRIGHT_INVOICES_TABLE=invoice-records-dev
# Real Textract + Step Functions — allow up to 5 minutes
PLAYWRIGHT_REVIEW_TIMEOUT_MS=300000

# Local Vite (mode dev → spa/.env.dev) or deployed SPA URL:
PLAYWRIGHT_SPA_BASE_URL=http://127.0.0.1:5173
# PLAYWRIGHT_SKIP_WEBSERVER=1
# PLAYWRIGHT_SPA_BASE_URL=https://xxxxxxxx.lambda-url.ap-southeast-2.on.aws/
